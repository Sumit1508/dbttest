-- This file contains the MERGE logic for DWH_Package_DBTPOC with inserted and updated row tracking
{% set source_model = ref('DWH_Package_dbtpoc') %}

DECLARE merge_query_id STRING;
DECLARE inserted_rows INT;
DECLARE updated_rows INT;

BEGIN
    -- Run the MERGE using EXECUTE IMMEDIATE
    EXECUTE IMMEDIATE '
        MERGE INTO DEV.ACCEL_BI_BR.DWH_Package_DBTPOC AS target
        USING ' || '''{{ ref('Stg_Package_dbtpoc') }}''' || ' AS source
        ON target.package_code = source.package_code
        WHEN MATCHED AND (
            target.pkg_name != source.pkg_name OR
            target.pkg_name_short != source.pkg_name_short OR
            target.pkg_desc != source.pkg_desc OR
            target.pkg_price != source.pkg_price OR
            target.pkg_active != source.pkg_active OR
            target.allow_ala_carte != source.allow_ala_carte OR
            target.init_comp != source.init_comp OR
            target.search_type_code != source.search_type_code OR
            target.yr_searched != source.yr_searched OR
            target.pkg_plus != source.pkg_plus OR
            target.no_addl_inof_needed != source.no_addl_inof_needed OR
            target.no_fm != source.no_fm OR
            target.name_count != source.name_count OR
            target.county_count != source.county_count OR
            target.ask_conv != source.ask_conv OR
            target.MMN_SHOW != source.MMN_SHOW OR
            target.ADD_POSITION_LOCATION_SEARCHES != source.ADD_POSITION_LOCATION_SEARCHES OR
            target.auto_W2_opt != source.auto_W2_opt OR
            target.auto_W2_utv != source.auto_W2_utv OR
            target.intl_address_question != source.intl_address_question OR
            target.sin_required != source.sin_required
        )
        THEN UPDATE SET
            pkg_name = source.pkg_name,
            pkg_name_short = source.pkg_name_short,
            pkg_desc = source.pkg_desc,
            pkg_price = source.pkg_price,
            pkg_active = source.pkg_active,
            allow_ala_carte = source.allow_ala_carte,
            init_comp = source.init_comp,
            search_type_code = source.search_type_code,
            yr_searched = source.yr_searched,
            pkg_plus = source.pkg_plus,
            no_addl_inof_needed = source.no_addl_inof_needed,
            no_fm = source.no_fm,
            name_count = source.name_count,
            county_count = source.county_count,
            ask_conv = source.ask_conv,
            MMN_SHOW = source.MMN_SHOW,
            ADD_POSITION_LOCATION_SEARCHES = source.ADD_POSITION_LOCATION_SEARCHES,
            auto_W2_opt = source.auto_W2_opt,
            auto_W2_utv = source.auto_W2_utv,
            intl_address_question = source.intl_address_question,
            sin_required = source.sin_required
        WHEN NOT MATCHED THEN INSERT (
            package_code,
            pkg_name,
            pkg_name_short,
            pkg_desc,
            pkg_price,
            pkg_active,
            allow_ala_carte,
            init_comp,
            search_type_code,
            yr_searched,
            pkg_plus,
            no_addl_inof_needed,
            no_fm,
            name_count,
            county_count,
            ask_conv,
            MMN_SHOW,
            ADD_POSITION_LOCATION_SEARCHES,
            auto_W2_opt,
            auto_W2_utv,
            intl_address_question,
            sin_required
        )
        VALUES (
            source.package_code,
            source.pkg_name,
            source.pkg_name_short,
            source.pkg_desc,
            source.pkg_price,
            source.pkg_active,
            source.allow_ala_carte,
            source.init_comp,
            source.search_type_code,
            source.yr_searched,
            source.pkg_plus,
            source.no_addl_inof_needed,
            source.no_fm,
            source.name_count,
            source.county_count,
            source.ask_conv,
            source.MMN_SHOW,
            source.ADD_POSITION_LOCATION_SEARCHES,
            source.auto_W2_opt,
            source.auto_W2_utv,
            source.intl_address_question,
            source.sin_required
        )';

    -- Get the query ID of the executed MERGE statement
    LET merge_query_id = LAST_QUERY_ID();

    -- Fetch counts for inserted rows
    SELECT VALUE::INT
    INTO :inserted_rows
    FROM TABLE(RESULT_SCAN(:merge_query_id))
    WHERE METRIC_NAME = 'rows_inserted';

    -- Fetch counts for updated rows
    SELECT VALUE::INT
    INTO :updated_rows
    FROM TABLE(RESULT_SCAN(:merge_query_id))
    WHERE METRIC_NAME = 'rows_updated';

    -- Log the counts for inserted and updated rows
    -- You can insert these values into your logging or tracking table if needed
    -- For example:
    INSERT INTO ACCEL_LOGGINGDB.MODEL_EXECUTION_LOGS (
        model_name, run_at, inserted_rows, updated_rows, dbt_user
    )
    VALUES (
        'DWH_Package_DBTPOC',
        CURRENT_TIMESTAMP(),
        :inserted_rows,
        :updated_rows,
        CURRENT_USER()
    );

END;
